<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl"
    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🕯️ שבת · ירושלים" android:textSize="11sp" android:textColor="#7A8A9E" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="5dp"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="כניסה" android:textSize="11sp" android:textColor="#F5A623" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="19:15" android:textSize="28sp" android:textStyle="bold" android:textColor="#F5A623" android:maxLines="1" android:includeFontPadding="false" android:minWidth="80dp"/>
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="34dp" android:background="#22FFFFFF"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="יציאה" android:textSize="11sp" android:textColor="#C4B5FD" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="20:25" android:textSize="28sp" android:textStyle="bold" android:textColor="#C4B5FD" android:maxLines="1" android:includeFontPadding="false" android:minWidth="80dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
